# 大米订购系统 - 环境变量示例
# 复制本文件为 .env.local 并填入真实值。
# 不要提交 .env、.env.local 或其他带真实密码的 env 文件。
# 数据库只监听本机。trust 认证不能对局域网开放。
# Web 默认只绑定 127.0.0.1。不要对 0.0.0.0 开放未登录的写入。

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rice_ordering
DB_USER=postgres
DB_PASSWORD=

# 应用
APP_ENV=development
APP_PORT=3721

# 会话密封密钥（iron-session）。至少 32 个字符。丢失或更换会使所有人重新登录。
# 生成：openssl rand -base64 32
# 不要提交真实值。
SESSION_SECRET=

# 生产环境（npm run start）默认给会话 cookie 加 Secure。
# 本机仍是 http://127.0.0.1 时，浏览器会丢掉 Secure cookie，登录会马上掉回登录页。
# 这时取消下一行注释。HTTPS 部署不要设 false。npm run dev 不需要。
# SESSION_COOKIE_SECURE=false
